rules_version = '2';

// Reglas de seguridad de la base de datos.
// Roles: "cliente" (todos al crear cuenta) y "dueno" (se pone a mano en la consola).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'dueno';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      // Cada quien edita sus datos, pero nadie se puede poner rol desde la app.
      allow create: if signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['role']);
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    match /products/{id} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    match /deliveryDays/{date} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // Panes apartados por día. Solo los escribe el servidor (functions/index.js).
    match /dayStock/{date} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // Ubicación en vivo del repartidor. Solo la ven los clientes con pedido ese día.
    match /tracking/{doc} {
      allow read: if isOwner()
        || (signedIn() && request.auth.uid in resource.data.get('viewers', []));
      allow write: if isOwner();
    }

    // Reseñas: una por pedido (el id del documento es el del pedido).
    // El cliente califica sus propios pedidos que no se cancelaron.
    // Las ve él, el dueño, y todos los clientes si el dueño la escogió para mostrar.
    match /reviews/{orderId} {
      allow read: if isOwner()
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || (signedIn() && resource.data.featured == true);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['customerId', 'customerName', 'rating', 'comment',
             'photoPath', 'items', 'deliveryDate', 'seen', 'featured', 'createdAt'])
        && request.resource.data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(orderId)).data.status != 'cancelado'
        && validReview(request.resource.data)
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 30
        && request.resource.data.seen == false
        && request.resource.data.featured == false
        && request.resource.data.createdAt == request.time;

      // El cliente puede cambiar su reseña; vuelve a salir como nueva y sin mostrar.
      allow update: if (signedIn()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['rating', 'comment', 'photoPath', 'seen', 'featured', 'updatedAt'])
          && validReview(request.resource.data)
          && request.resource.data.seen == false
          && request.resource.data.featured == false
          && request.resource.data.updatedAt == request.time)
        // El dueño solo la marca vista o la escoge para mostrar.
        || (isOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'featured']));

      allow delete: if isOwner();
    }

    function validReview(d) {
      return d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.comment is string && d.comment.size() <= 600
        && (d.photoPath == null
            || (d.photoPath is string && d.photoPath.matches('review-photos/' + request.auth.uid + '/.*')));
    }

    // Ideas de pan nuevo que mandan los clientes.
    match /suggestions/{id} {
      allow read: if isOwner() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['customerId', 'customerName', 'text', 'seen', 'liked', 'createdAt'])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.seen == false
        && request.resource.data.liked == false
        && request.resource.data.createdAt == request.time;
      // El dueño la marca vista o le da "Me gusta la idea".
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'liked']);
      allow delete: if isOwner();
    }

    match /orders/{id} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isOwner());

      // Los pedidos se hacen con la función "hacerPedido", que revisa el cupo.
      // Crear directo solo se deja (para versiones viejas de la app) en días sin cupo.
      // El cliente crea su pedido "recibido", sin marcar pagos y con un día abierto.
      // No hay hora límite: se puede pedir hasta que el dueño empieza a repartir
      // ("closed") o hasta que termina el día (00:00 UTC + 30 h = medianoche en México).
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'recibido'
        && request.resource.data.paymentVerified == false
        && request.resource.data.cashCollected == false
        && request.resource.data.paymentMethod in ['transferencia', 'efectivo']
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && exists(/databases/$(database)/documents/deliveryDays/$(request.resource.data.deliveryDate))
        && get(/databases/$(database)/documents/deliveryDays/$(request.resource.data.deliveryDate)).data.open == true
        && get(/databases/$(database)/documents/deliveryDays/$(request.resource.data.deliveryDate)).data.get('closed', false) == false
        && get(/databases/$(database)/documents/deliveryDays/$(request.resource.data.deliveryDate)).data.get('stock', {}).size() == 0
        // Días especiales (entrega en un punto) solo por hacerPedido.
        && get(/databases/$(database)/documents/deliveryDays/$(request.resource.data.deliveryDate)).data.get('punto', null) == null
        && request.time < timestamp.date(
             int(request.resource.data.deliveryDate.split('-')[0]),
             int(request.resource.data.deliveryDate.split('-')[1]),
             int(request.resource.data.deliveryDate.split('-')[2])) + duration.value(30, 'h');

      // Solo el dueño cambia estados, pagos y cobros.
      allow update, delete: if isOwner();
    }
  }
}
