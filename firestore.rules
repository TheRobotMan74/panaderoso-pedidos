rules_version = '2';

// Reglas de seguridad de la base de datos.
// Roles: "cliente" (todos al crear cuenta) y "dueno" (se pone a mano en la consola).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'dueno';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      // Cada quien edita sus datos, pero nadie se puede poner rol desde la app.
      allow create: if signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['role']);
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    match /products/{id} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    match /deliveryDays/{date} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // Panes apartados por día. Solo los escribe el servidor (functions/index.js).
    match /dayStock/{date} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // Ubicación en vivo del repartidor. Solo la ven los clientes con pedido ese día.
    match /tracking/{doc} {
      allow read: if isOwner()
        || (signedIn() && request.auth.uid in resource.data.get('viewers', []));
      allow write: if isOwner();
    }

    match /orders/{id} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isOwner());

      // Los pedidos se hacen con la función "hacerPedido", que revisa el cupo.
      // Crear directo solo se deja (para versiones viejas de la app) en días sin cupo.
      // El cliente crea su pedido "recibido", sin marcar pagos y con un día abierto.
      // No hay hora límite: se puede pedir hasta que el dueño empieza a repartir
      // ("closed") o hasta que termina el día (00:00 UTC + 30 h = medianoche en México).
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'recibido'
        && request.resource.data.paymentVerified == false
        && request.resource.data.cashCollected == false
        && request.resource.data.paymentMethod in ['transferencia', 'efectivo']
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && exists(/databases/$(database)/documents/deliveryDays/$(request.resource.data.deliveryDate))
        && get(/databases/$(database)/documents/deliveryDays/$(request.resource.data.deliveryDate)).data.open == true
        && get(/databases/$(database)/documents/deliveryDays/$(request.resource.data.deliveryDate)).data.get('closed', false) == false
        && get(/databases/$(database)/documents/deliveryDays/$(request.resource.data.deliveryDate)).data.get('stock', {}).size() == 0
        && request.time < timestamp.date(
             int(request.resource.data.deliveryDate.split('-')[0]),
             int(request.resource.data.deliveryDate.split('-')[1]),
             int(request.resource.data.deliveryDate.split('-')[2])) + duration.value(30, 'h');

      // Solo el dueño cambia estados, pagos y cobros.
      allow update, delete: if isOwner();
    }
  }
}
