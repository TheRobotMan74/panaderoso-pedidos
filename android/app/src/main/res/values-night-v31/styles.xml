<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 y más nuevos: el sistema dibuja el arranque con el ícono del oso
         sobre papel crema (en vez de blanco o negro). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/crema</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/crema</item>
    </style>
</resources>
